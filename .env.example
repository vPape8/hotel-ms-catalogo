# Copia este archivo como .env y reemplaza los valores de ejemplo.
PORT=8088

# Kafka: bootstrap-servers (en docker-compose: kafka-1:29092,kafka-2:29092,kafka-3:29092).
# El servicio crea los tópicos "catalogo" (compactado) y "catalogo.DLT", y consume "reservas" con el grupo "disponibilidad".
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_GRUPO=disponibilidad
# Un miembro por partición de "reservas".
KAFKA_CONCURRENCIA=3
KAFKA_REINTENTOS_INTENTOS=3
KAFKA_REINTENTOS_ESPERA_MS=1000

# MySQL: tablas catalogo_hoteles, catalogo_habitaciones y catalogo_ocupaciones. Vacío = memoria.
# La primera vez se cargan los 24 hoteles y 92 habitaciones del frontend de huéspedes.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hotel

# Microsoft Entra ID: crear y editar habitaciones es solo para el rol ADMIN (la lectura es pública).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
ENTRA_EXIGIR_ROL=true
ENTRA_ROL_REQUERIDO=ADMIN
